---
import Base from "../layouts/Base.astro";
import { href } from "../site";
---
<Base title="Page not found" description="This page does not exist." og="404" noindex>
  <div class="container wrap">
    <p class="eyebrow">404</p>
    <h1>This page does not exist.</h1>
    <p class="lede">The address may be mistyped, or the page may have moved.</p>
    <p class="actions">
      <a class="button button-primary" href={href("/")}>Go to the home page</a>
      <a class="button button-secondary" href={href("/docs/getting-started/")}>Read the guide</a>
    </p>
  </div>
</Base>

<style>
  .wrap {
    padding-block: var(--s-9);
  }

  h1 {
    font-size: var(--text-3xl);
    letter-spacing: -0.025em;
    margin-block: var(--s-2) var(--s-4);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-6);
  }
</style>
