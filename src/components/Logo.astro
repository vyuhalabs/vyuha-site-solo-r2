---
// The mark: seven points in a chevron, a formation that moves as one.
interface Props {
  size?: number;
}
const { size = 22 } = Astro.props;
---
<svg
  class="mark"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
>
  <circle cx="12" cy="5" r="2.2" fill="var(--accent)"></circle>
  <circle cx="8" cy="10" r="2" fill="currentColor"></circle>
  <circle cx="16" cy="10" r="2" fill="currentColor"></circle>
  <circle cx="4.5" cy="15" r="1.8" fill="currentColor" opacity="0.7"></circle>
  <circle cx="19.5" cy="15" r="1.8" fill="currentColor" opacity="0.7"></circle>
  <circle cx="1.8" cy="19.8" r="1.5" fill="currentColor" opacity="0.45"></circle>
  <circle cx="22.2" cy="19.8" r="1.5" fill="currentColor" opacity="0.45"></circle>
</svg>
