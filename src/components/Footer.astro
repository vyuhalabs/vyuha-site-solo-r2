---
import { ACCESS_URL, href, SITE } from "../site";
import Logo from "./Logo.astro";
---
<footer class="site-footer">
  <div class="container grid">
    <div class="about">
      <p class="brand"><Logo size={18} /> vyuha</p>
      <p class="muted">
        <span lang="sa">vyuha</span> is Sanskrit for a formation: an arrangement of forces that moves
        as one.
      </p>
    </div>
    <nav aria-label="Footer">
      <h2 class="heading">Learn</h2>
      <ul>
        <li><a href={href("/docs/model/")}>The model</a></li>
        <li><a href={href("/docs/getting-started/")}>Getting started</a></li>
        <li><a href={href("/faq/")}>FAQ</a></li>
      </ul>
    </nav>
    <div>
      <h2 class="heading">Next step</h2>
      <ul>
        <li><a href={ACCESS_URL}>Ask for access</a></li>
        <li><a href={SITE.repo}>Site source</a></li>
      </ul>
    </div>
  </div>
  <div class="container fine">
    <p>This site sets no cookies and runs no third-party scripts.</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--s-10);
    border-top: 1px solid var(--border);
    background: var(--bg-subtle);
    padding-block: var(--s-8) var(--s-6);
    font-size: var(--text-sm);
  }

  .grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: var(--s-6);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    font-weight: 700;
    font-size: var(--text-md);
    margin-bottom: var(--s-2);
  }

  .muted {
    color: var(--text-muted);
    max-width: 22rem;
  }

  .heading {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-faint);
    margin-bottom: var(--s-3);
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li + li {
    margin-top: var(--s-1);
  }

  a {
    color: var(--text-muted);
    text-decoration: none;
    display: inline-block;
    padding-block: 0.25rem;
  }

  a:hover {
    color: var(--text);
    text-decoration: underline;
  }

  .fine {
    margin-top: var(--s-7);
    padding-top: var(--s-5);
    border-top: 1px solid var(--border);
    color: var(--text-faint);
  }

  @media (max-width: 40rem) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
    .about {
      grid-column: 1 / -1;
    }
  }
</style>
