---
import { href, NAV } from "../site";
import Logo from "./Logo.astro";

const current = Astro.url.pathname;
---
<header class="site-header">
  <div class="container bar">
    <a class="brand" href={href("/")} aria-label="vyuha home">
      <Logo />
      <span>vyuha</span>
    </a>
    <nav aria-label="Main">
      <ul>
        {
          NAV.map((item) => {
            const target = href(item.path);
            const active = current.startsWith(target);
            return (
              <li>
                <a href={target} aria-current={active ? "page" : undefined}>
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 5;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    -webkit-backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--border);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    height: 3.75rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    color: var(--text);
    font-weight: 700;
    font-size: var(--text-lg);
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  ul {
    display: flex;
    gap: var(--s-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 var(--s-3);
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
  }

  nav a:hover {
    color: var(--text);
    background: var(--surface-2);
  }

  nav a[aria-current="page"] {
    color: var(--text);
  }

  @media (max-width: 30rem) {
    nav a {
      padding: 0 var(--s-2);
    }
  }
</style>
